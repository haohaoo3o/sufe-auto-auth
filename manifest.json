{
  "manifest_version": 3,
  "name": "上财自动认证",
  "version": "6.0.0",
  "description": "检测上海财经大学统一认证（login.sufe.edu.cn）登录页，自动识别字符验证码并登录（识别失败自动重试，超限转人工）。仅限本人账号使用。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://login.sufe.edu.cn/*",
    "https://login-sufe-edu-cn-s.webvpn.sufe.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "上财自动认证 · 设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": [
        "https://login.sufe.edu.cn/*",
        "https://login-sufe-edu-cn-s.webvpn.sufe.edu.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://login.sufe.edu.cn/*",
        "https://login-sufe-edu-cn-s.webvpn.sufe.edu.cn/*"
      ],
      "js": [
        "sufe-crypto.js",
        "sufe-cnn-weights.js",
        "sufe-cnn.js",
        "sufe-fx.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}